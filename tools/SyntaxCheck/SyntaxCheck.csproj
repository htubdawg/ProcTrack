<Project Sdk="Microsoft.NET.Sdk">
  <!-- Parses the mod's C# the way HalfGripTools does (Roslyn 4.8, C# 10) without the game's DLLs.
       It finds syntax errors only; type errors need the game, see tools/check-mods.ps1 in HalfGripTools. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
